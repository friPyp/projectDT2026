generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  PARTNER
  ADMIN
}

enum PartnerType {
  UNIVERSITY
  INDUSTRY
}

enum Category {
  EDUCATION
  AGRICULTURE
  HEALTHCARE
  WATER
  ENVIRONMENT
  ENERGY
  URBAN_DEVELOPMENT
  PUBLIC_ADMIN
}

enum ChallengeStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  CHALLENGE_ASSIGNED
  STATUS_UPDATED
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  role         Role
  district     String?
  createdAt    DateTime @default(now())

  partner       Partner?
  challenges    Challenge[]    @relation("CitizenChallenges")
  notifications Notification[]

  @@map("users")
}

model Partner {
  id        String      @id @default(cuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id])
  orgName   String
  type      PartnerType
  domains   Category[]
  createdAt DateTime    @default(now())

  challenges Challenge[] @relation("PartnerChallenges")
  contacts   PartnerContact[]
  // Phase 2 Session 14: status notes this partner has posted.
  updates    ChallengeUpdate[]
  // Phase 2 Session 15: every challenge this partner is assigned to.
  assignments ChallengeAssignment[]

  @@map("partners")
}

// Phase 2 Session 12 (PROJECT_REFERENCE.md §6a/§8a): a partner declares
// one or more contact channels (their own choice of label — "Phone",
// "Email", "Office", etc. — not a fixed enum) so citizens routed to them
// have a direct way to reach them, rather than only seeing status via
// the dashboard.
model PartnerContact {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  label     String
  value     String
  createdAt DateTime @default(now())

  @@map("partner_contacts")
}

model Challenge {
  id                String          @id @default(cuid())
  citizenId         String
  citizen           User            @relation("CitizenChallenges", fields: [citizenId], references: [id])
  title             String
  description       String
  category          Category
  district          String
  // Phase 2 Session 11: optional plain-text location detail, beyond
  // district. Text only — no maps/GPS (PROJECT_REFERENCE.md §2 ban stands).
  state             String?
  city              String?
  locality          String?
  address           String?
  status            ChallengeStatus @default(SUBMITTED)
  assignedPartnerId String?
  assignedPartner   Partner?        @relation("PartnerChallenges", fields: [assignedPartnerId], references: [id])
  team              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  // Phase 2 Session 13: append-only history of citizen edits.
  editLogs          ChallengeEditLog[]
  // Phase 2 Session 14: append-only partner status notes.
  updates           ChallengeUpdate[]
  // Phase 2 Session 15: all domains the challenge was routed on (primary
  // `category` included), and one assignment per partner working on it.
  domains           Category[]            @default([])
  assignments       ChallengeAssignment[]

  @@map("challenges")
}

// Phase 2 Session 13: one row per saved citizen edit. Append-only — no
// update or delete routes, ever (PROJECT_REFERENCE.md §8a, Session 13).
model ChallengeEditLog {
  id            String    @id @default(cuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  editedAt      DateTime  @default(now())
  // { "<field>": { "before": ..., "after": ... } } for changed fields only
  changedFields Json

  @@index([challengeId], map: "challenge_edit_logs_challengeId_idx")
  @@map("challenge_edit_logs")
}

// Phase 2 Session 14: a short status note a partner posts against a
// challenge. Append-only — no update or delete routes, ever
// (PROJECT_REFERENCE.md §6a/§8a). Separate from the coarse status enum.
model ChallengeUpdate {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  note        String
  createdAt   DateTime  @default(now())

  @@index([challengeId], map: "challenge_updates_challengeId_idx")
  @@map("challenge_updates")
}

// Phase 2 Session 15: one row per partner assigned to a challenge, with
// that partner's own progress. The challenge's status is derived from
// these rows (PROJECT_REFERENCE.md §8a, Session 15 decided design).
model ChallengeAssignment {
  id          String          @id @default(cuid())
  challengeId String
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partnerId   String
  partner     Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status      ChallengeStatus @default(ASSIGNED)
  assignedAt  DateTime        @default(now())

  @@unique([challengeId, partnerId])
  @@index([partnerId], map: "challenge_assignments_partnerId_idx")
  @@map("challenge_assignments")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}
